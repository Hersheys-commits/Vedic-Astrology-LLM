# Copy to .env and fill in your local values.
# Never commit .env or paste your API key into source control.

# --- Service ---
APP_PORT=8001
APP_HOST=0.0.0.0

# --- Upstream chart-engine ---
CHART_ENGINE_URL=http://localhost:8000
CHART_ENGINE_TIMEOUT_SECONDS=15
EVALUATION_RAG_URL=http://localhost:8001

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_STRATEGY=hybrid
PER_FACT_TOP_K=5
SEMANTIC_FALLBACK_MIN_HITS=3

# --- OpenAI generation ---
# Leave blank to run in mock mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GENERATION_MAX_TOKENS=1200
# Required by scripts/evaluate_end_to_end.py for a separate answer judge.
EVAL_JUDGE_MODEL=

# --- Intel NPU generation ---
# Lower prompt lengths reduce host RAM demand during LLMPipeline compilation.
OPENVINO_NPU_MODEL_DIR=models/astro-qwen-npu-v2
OPENVINO_NPU_MAX_PROMPT_LEN=1536
OPENVINO_NPU_MAX_NEW_TOKENS=1024

# --- Intent extraction ---
# auto = use OpenAI when OPENAI_API_KEY is set, otherwise deterministic rules.
# rules = never call an LLM for fact extraction.
INTENT_MODE=auto
INTENT_MODEL=
INTENT_MAX_TOKENS=1500
