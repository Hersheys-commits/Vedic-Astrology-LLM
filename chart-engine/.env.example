# Directory containing Swiss Ephemeris .se1 files.
# Leave as-is and the engine uses the built-in Moshier ephemeris (no files needed).
EPHEMERIS_PATH=./data/ephe

# Supported birth-year range (validated before any calculation).
MIN_YEAR=1700
MAX_YEAR=2100

# Geocoding provider. Nominatim requires a real contact in the User-Agent.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=vedic-chart-engine/0.1 (contact: you@example.com)
GEOCODER_TIMEOUT=10
